<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Jeverb</vendor>
  <vendor_url>https://github.com/Brainwires/jevwire</vendor_url>
  <action id="org.jeverb.control.set-off">
    <description>Turn Jeverb OFF</description>
    <message>Authorize switching Jeverb OFF</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.jeverb.control.set-on">
    <description>Turn Jeverb ON</description>
    <message>Authorize switching Jeverb ON</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.jeverb.control.attest-pass">
    <description>Attest that a mission candidate passed independent verification</description>
    <message>Authorize recording a passing independent verification for the shown mission candidate</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.jeverb.control.attest-fail">
    <description>Attest that a mission candidate failed independent verification</description>
    <message>Authorize recording a failing independent verification for the shown mission candidate</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.jeverb.control.proof-plan">
    <description>Authorize a host proof-obligation plan for a mission</description>
    <message>Authorize storing the reviewed proof-obligation plan for the shown mission</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
